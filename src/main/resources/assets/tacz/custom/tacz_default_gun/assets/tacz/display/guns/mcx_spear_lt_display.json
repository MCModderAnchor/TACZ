{
  "ads_preset": "tacz:renew",
  "model": "tacz:gun/mcx_spear_lt_geo",
  "texture": "tacz:gun/uv/mcx_spear_lt",
  "lod": {
    "model": "tacz:gun/lod/mcx_spear_lt",
    "texture": "tacz:gun/lod/mcx_spear_lt"
  },
  "hud": "tacz:gun/hud/mcx_spear_lt",
  "slot": "tacz:gun/slot/mcx_spear_lt",
  "animation": "tacz:mcx_spear_lt",
  "state_machine": "tacz:mcx_spear_lt_state_machine",
  "use_default_animation": "rifle",
  "third_person_animation": "default",
  "transform": {
    "scale": {
      "thirdperson": [0.6, 0.6, 0.6],
      "ground": [0.6, 0.6, 0.6],
      "fixed": [1.2, 1.2, 1.2]
    }
  },
  "muzzle_flash": {
    "type": "renew",
    "texture": "tacz:flash/common_muzzle_flash",
    "scale": 0.75,
    "smoke_scale": 1.45,
    "initial_speed_scale": 1.5,
    "smoke_directions": [
      { "plane_angle": 0, "out_angle": 0 },
      { "plane_angle": 180, "out_angle": 0 }
    ],
    "smoke_spread_angle": 25
  },
  "iron_zoom": 1.33,
  "model_fov": 60,
  "zoom_model_fov": 45,
  "shell": {
    "initial_velocity": [5, 2, 1],
    "random_velocity": [1, 1, 0.25],
    "acceleration": [0.0, -10, 0.0],
    "angular_velocity": [360, -1200, 90],
    "living_time": 1.0
  },
  "sounds": {
    "shoot": "tacz:mcx_spear_lt/mcx_spear_lt_shoot",
    "shoot_3p": "tacz:mcx_spear_lt/mcx_spear_lt_shoot_3p",
    "draw": "tacz:mcx_spear_lt/mcx_spear_lt_draw",
    "put_away": "tacz:mcx_spear_lt/mcx_spear_lt_put_away",
    "silence": "tacz:mcx_spear_lt/mcx_spear_lt_silence",
    "silence_3p": "tacz:mcx_spear_lt/mcx_spear_lt_silence_3p",
    "melee_push": "tacz:melee_stock/melee_stock_01",
    "melee_stock": "tacz:melee_stock/melee_stock_02"
  },
  // 副手枪械显示
  "offhand_show": {
    // 位置，和基岩版的数值显示一致
    // 默认是 [-2, 20, 3.5]
    "pos": [3, 20, 3.5],
    // 旋转，单位为角度，默认就是 [0, 0, -30]
    "rotate": [0, 0, 60],
    // 缩放，默认就是 [0.6, 0.6, 0.6]
    "scale": [0.5, 0.5, 0.5]
  },
  // 快捷栏枪械显示
  // 没有此字段，不显示快捷栏枪械
  "hotbar_show": {
    // 快捷栏索引，默认是 0-8，共九个，但是实际上除去主手，只能显示八个
    // 没有的，则不会显示
    "0": {
      "pos": [-3, 20, 3],
      "rotate": [-180, 0, 120],
      "scale": [0.5, 0.5, 0.5]
    }
  }
}
