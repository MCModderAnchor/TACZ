{
  "slot": "tacz:attachment/slot/sight_infitac_fmp13",
  "model": "tacz:attachment/sight_infitac_fmp13_geo",
  "texture": "tacz:attachment/uv/sight_infitac_fmp13",
  "lod": {
    "model": "tacz:attachment/lod/sight_infitac_fmp13",
    "texture": "tacz:attachment/lod/sight_infitac_fmp13"
  },
  "zoom": [
    1.25
  ],
  "scope": true,
  "sight": false,
  "fov": 45.0,
  "scope_lens":{
    "distortion": 0,              //  边缘径向畸变强度，范围0-0.2。默认0.05
    "aberration": 0.007,          //  边缘 RGB分离强度，范围0-0.03。默认0.007
    "edge_width": 0.35,           //  畸变及色散的边缘过渡宽度，范围0-2;0关闭畸变及色散，不影响暗角。默认0.35
    "vignette_strength": 1.0,     //  暗角强度，范围0-1；0关闭暗角，不影响畸变及色散。默认1.0
    "vignette_width": 0.25,       //  暗角过渡宽度，范围0-2；0关闭暗角，不影响畸变及色散。默认0.35
    "tint": "#70AEE8",            //  光学偏色，使用#RRGGBB；非法颜色回退白色。默认#70AEE8
    "tint_strength": 0.2,         //  偏色强度，范围0-1；0为原色。默认0.2
    "vision_mode": "THERMAL_IRONBOW",
    //  成像模式预设：
    //  NORMAL                原光学镜片偏色、畸变、色散和暗角
    //  NIGHT_VISION_GREEN    暗部增强和绿磷色调
    //  NIGHT_VISION_WHITE    暗部增强和偏冷白磷色调
    //  THERMAL_WHITE_HOT     冷背景、亮目标
    //  THERMAL_BLACK_HOT     亮背景、暗目标
    //  THERMAL_IRONBOW       深紫冷背景、红黄到白色目标
    //  未知值或 null 回退普通光学效果
    "vision_gain": 3.0,           //  夜视增益，范围1-12。默认3.0
    "vision_noise": 0.1          //  夜视及热成像噪点，范围0-0.2;0关闭。默认0.025
  },
  "sounds": {
    "install": "tacz:attachments/scope_general_e",
    "uninstall": "tacz:attachments/scope_general_e"
  }
}