  },
  "ammo": {
    // 曳光弹颜色，没有则为 #FFFFFF，没有此字段时，会调用 ammo 的相关字段
    // 严格遵循 RGB 颜色代码
    "tracer_color": "#FF8888",
    // 是否覆盖 ammo display 的弹孔贴花开关。没有该字段时，会调用 ammo 的 enable_bullet_hole。
    //"enable_bullet_hole": true,
    // 命中方块表面时额外播放的粒子效果。取消注释后可用 AK47 测试火焰和烟雾命中特效。
    "hit_surface_particles": [
      {
        "name": "minecraft:cloud",
        "count": 5,
        "count_range": [4, 6],
        "life_time": 13,
        "color": "#8A8175",
        "scale": 1.15,
        "surface_offset": 0.055,
        "random_offset": 0.025,
        "normal_speed": 0.16,
        "random_speed": 0.03,
        "spread_angle": 18
      },
      {
        "name": "minecraft:campfire_cosy_smoke",
        "count": 3,
        "count_range": [2, 5],
        "life_time": 60,
        "scale": 1.1,
        "surface_offset": 0.06,
        "random_offset": 0.035,
        "normal_speed": 0.04,
        "random_speed": 0.02,
        "spread_angle": 45
      }
    ]
  },
  "sounds": {
    "shoot": "tacz:mk20/mk20_shoot",
    "shoot_3p": "tacz:mk20/mk20_shoot_3p",
    "silence": "tacz:mk20/mk20_silence",
    "silence_3p": "tacz:mk20/mk20_silence_3p",
    "dry_fire": "tacz:dry_fire",
    "fire_select": "tacz:fire_select",
    "head_hit": "tacz:head_hit",
    "flesh_hit": "tacz:flesh_hit",
    "kill": "tacz:kill",
    "melee_push": "tacz:melee_stock/melee_stock_01",
    "melee_stock": "tacz:melee_stock/melee_stock_03"
  },
  // 副手枪械显示
  "offhand_show": {
    // 位置，和基岩版的数值显示一致
    // 默认是 [-2, 20, 3.5]
    "pos": [3, 22.5, 3.5],
    // 旋转，单位为角度，默认就是 [0, 0, -30]
    "rotate": [0, 0, 60],
    // 缩放，默认就是 [0.6, 0.6, 0.6]
    "scale": [0.5, 0.5, 0.5]
  },
  // 快捷栏枪械显示
  // 没有此字段，不显示快捷栏枪械
  "hotbar_show": {
    // 快捷栏索引，默认是 0-8，共九个，但是实际上除去主手，只能显示八个
    // 没有的，则不会显示
    "0": {
      "pos": [-3, 22.5, 3],
      "rotate": [-180, 0, 120],
      "scale": [0.5, 0.5, 0.5]
    }
  }
}
