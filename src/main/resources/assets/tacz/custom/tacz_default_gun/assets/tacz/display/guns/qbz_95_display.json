{
  "model": "tacz:gun/qbz_95_geo",
  "texture": "tacz:gun/uv/qbz_95",
  "lod": {
    "model": "tacz:gun/lod/qbz_95",
    "texture": "tacz:gun/lod/qbz_95"
  },
  "hud": "tacz:gun/hud/qbz_95",
  "slot": "tacz:gun/slot/qbz_95",
  "animation": "tacz:qbz_95",
  "use_default_animation": "rifle",
  "third_person_animation": "default",
  "transform": {
    "scale": {
      "thirdperson": [0.6, 0.6, 0.6],
      "ground": [0.6, 0.6, 0.6],
      "fixed": [1.2, 1.2, 1.2]
    }
  },
  "muzzle_flash": {
    "type": "renew",
    "texture": "tacz:flash/common_muzzle_flash",
    "scale": 0.3,
    "smoke_scale": 1.25,
    "initial_speed_scale": 1.5,
    "smoke_particle_count": 10,
    "smoke_directions": [
      { "plane_angle": 0, "out_angle": 0 },
      { "plane_angle": 180, "out_angle": 0 }
    ]
  },
  "iron_zoom": 1.33,
  "model_fov": 60,
  "zoom_model_fov": 60,
  "shell": {
    // 抛壳的初速度
    "initial_velocity": [6, 2, -4.5],
    // 抛壳随机变化的运动速度
    "random_velocity": [2, 1.5, 0.5],
    // 抛壳的加速度
    "acceleration": [0.0, -12.5, 0.0],
    // 抛壳的三轴角速度
    "angular_velocity": [360, -1200, 90],
    // 抛壳渲染存活时间，单位为秒
    "living_time": 1.0
  },
  "sounds": {
    "draw": "tacz:qbz_95/qbz_95_draw",
    "put_away": "tacz:qbz_95/qbz_95_put_away",
    "shoot": "tacz:qbz_95/qbz_95_shoot",
    "shoot_3p": "tacz:qbz_95/qbz_95_shoot_3p",
    "silence": "tacz:qbz_95/qbz_95_silence",
    "silence_3p": "tacz:qbz_95/qbz_95_silence_3p",
    "dry_fire": "tacz:dry_fire",
    "fire_select": "tacz:fire_select",
    "head_hit": "tacz:head_hit",
    "flesh_hit": "tacz:flesh_hit",
    "kill": "tacz:kill",
    "melee_push": "tacz:melee_stock/melee_stock_01",
    "melee_stock": "tacz:melee_stock/melee_stock_03"
  },
  // 副手枪械显示
  "offhand_show": {
    // 位置，和基岩版的数值显示一致
    // 默认是 [-2, 20, 3.5]
    "pos": [1, 18, 3.5],
    // 旋转，单位为角度，默认就是 [0, 0, -30]
    "rotate": [0, 0, 70],
    // 缩放，默认就是 [0.6, 0.6, 0.6]
    "scale": [0.5, 0.5, 0.5]
  },
  // 快捷栏枪械显示
  // 没有此字段，不显示快捷栏枪械
  "hotbar_show": {
    // 快捷栏索引，默认是 0-8，共九个，但是实际上除去主手，只能显示八个
    // 没有的，则不会显示
    "0": {
      "pos": [-1, 18, 3],
      "rotate": [-180, 0, 140],
      "scale": [0.5, 0.5, 0.5]
    }
  }
}
