{
  "state_machine": "tacz:default_state_machine_v2",
  "ads_preset": "tacz:renew",
  "model": "tacz:gun/aug_geo",
  "texture": "tacz:gun/uv/aug",
  "lod": {
    "model": "tacz:gun/lod/aug",
    "texture": "tacz:gun/lod/aug"
  },
  "hud": "tacz:gun/hud/aug",
  "slot": "tacz:gun/slot/aug",
  "animation": "tacz:aug",
  "use_default_animation": "rifle",
  "third_person_animation": "default",
  "transform": {
    "scale": {
      "thirdperson": [0.6, 0.6, 0.6],
      "ground": [0.6, 0.6, 0.6],
      "fixed": [1.2, 1.2, 1.2]
    }
  },
  "muzzle_flash": {
    "type": "renew",
    "texture": "tacz:flash/common_muzzle_flash",
    "scale": 0.4,
    "smoke_scale": 1.25,
    "initial_speed_scale": 1.5,
    "smoke_particle_count": 10,
    "smoke_directions": [
      { "plane_angle": 0, "out_angle": 0 },
      { "plane_angle": 180, "out_angle": 0 }
    ],
    "smoke_spread_angle": 60
  },
  "iron_zoom": 1.2,
  "model_fov": 60,
  "zoom_model_fov": 60,
  "shell": {
    "initial_velocity": [5, 2, 1],
    "random_velocity": [1, 1, 0.25],
    "acceleration": [0.0, -10, 0.0],
    "angular_velocity": [360, -1200, 90],
    "living_time": 1.0
  },
  "sounds": {
    "shoot": "tacz:aug/aug_shoot",
    "shoot_3p": "tacz:aug/aug_shoot_3p",
    "silence": "tacz:aug/aug_silence",
    "silence_3p": "tacz:aug/aug_silence_3p",
    "reload_empty": "tacz:aug/aug_reload_empty",
    "reload_tactical": "tacz:aug/aug_reload_tactical",
    "inspect": "tacz:aug/aug_inspect",
    "inspect_empty": "tacz:aug/aug_inspect_empty",
    "draw": "tacz:aug/aug_draw",
    "put_away": "tacz:aug/aug_put_away",
    "melee_push": "tacz:melee_stock/melee_stock_01",
    "melee_stock": "tacz:melee_stock/melee_stock_02"
  },
  // 副手枪械显示
  "offhand_show": {
    // 位置，和基岩版的数值显示一致
    // 默认是 [-2, 20, 3.5]
    "pos": [1, 18, 3.5],
    // 旋转，单位为角度，默认就是 [0, 0, -30]
    "rotate": [0, 0, 60],
    // 缩放，默认就是 [0.6, 0.6, 0.6]
    "scale": [0.5, 0.5, 0.5]
  },
  // 快捷栏枪械显示
  // 没有此字段，不显示快捷栏枪械
  "hotbar_show": {
    // 快捷栏索引，默认是 0-8，共九个，但是实际上除去主手，只能显示八个
    // 没有的，则不会显示
    "0": {
      "pos": [-1, 18, 3],
      "rotate": [-180, 0, 120],
      "scale": [0.5, 0.5, 0.5]
    }
  }
}
