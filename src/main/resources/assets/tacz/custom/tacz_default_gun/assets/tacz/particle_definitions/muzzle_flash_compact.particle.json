{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "tacz:muzzle_flash_compact",
      "basic_render_parameters": {
        "material": "energy_swirl",
        "texture": "tacz:particle/flash_strip"
      }
    },
    "components": {
      "sbm:fp_emitter_local_space": { "position": true, "rotation": false, "velocity": false, "to_world": false },
      "minecraft:emitter_rate_instant": { "num_particles": 1 },
      "minecraft:emitter_lifetime_once": { "active_time": 0.2 },
      "minecraft:emitter_shape_point": { "offset": [0, 0, 0] },
      "minecraft:particle_lifetime_expression": { "max_lifetime": 0.02 },
      "minecraft:particle_initial_spin": { "rotation": "math.random(-60, 60)", "rotation_rate": 0 },
      "minecraft:particle_appearance_billboard": {
        "size": ["v.muzzle_scale == 0 ? 0.36 : v.muzzle_scale * 0.36", "v.muzzle_scale == 0 ? 0.36 : v.muzzle_scale * 0.36"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 1152,
          "texture_height": 64,
          "uv": ["math.floor(v.particle_random_1 * 14) * 64 + 256", 0],
          "uv_size": [64, 64]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": { "0.0": "#FFFFFFFF", "0.9": "#FFFFFFFF", "1.0": "#00FFFFFF" }
        }
      }
    }
  }
}
