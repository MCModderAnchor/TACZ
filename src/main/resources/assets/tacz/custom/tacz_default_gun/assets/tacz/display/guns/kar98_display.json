{
  "ads_preset": "tacz:renew",
  "model": "tacz:gun/kar98_geo",
  "texture": "tacz:gun/uv/kar98",
  "lod": {
    "model": "tacz:gun/lod/kar98",
    "texture": "tacz:gun/lod/kar98"
  },
  "hud": "tacz:gun/hud/kar98",
  "state_machine": "tacz:kar98_state_machine",
  "state_machine_param": {
    "bolt_shell_ejecting_time": 0.3,
    "intro_shell_ejecting_time": 0.4,
    "intro_shell_ejecting_time_scoped": 0.3
  },
  "slot": "tacz:gun/slot/kar98",
  "animation": "tacz:kar98",
  "use_default_animation": "rifle",
  "third_person_animation": "default",
  "transform": {
    "scale": {
      "thirdperson": [0.6, 0.6, 0.6],
      "ground": [0.6, 0.6, 0.6],
      "fixed": [1.2, 1.2, 1.2]
    }
  },
  "muzzle_flash": {
    "type": "renew",
    "texture": "tacz:flash/common_muzzle_flash",
    "scale": 1,
    "smoke_scale": 2,
    "initial_speed_scale": 2.45,
    "smoke_particle_count": 30
  },
  "ammo":{
    "particle": {
    // 名称，具体可选粒子可参考 wiki：https://minecraft.fandom.com/zh/wiki/%E7%B2%92%E5%AD%90
    "name": "mycelium",
    // 生成的区域，默认为 0 0 0
    "delta": [
      0,
      0,
      0
    ],
    // 速度，默认为0，必须至少为 0
    "speed": 0.0,
    // 粒子存在时间，单位 tick，默认为 20 tick
    "life_time": 25,
    // 粒子数量，当子弹速度过快时，可以增大此数量，能够填满子弹路径的空隙
    "count": 75
    }
  },
  "iron_zoom": 2,
  "model_fov": 60,
  "shell": {
    "initial_velocity": [4, 2, -3.5],
    "random_velocity": [2, 1, 3],
    "acceleration": [0.0, -22.5, 0.0],
    "angular_velocity": [360, -1200, 90],
    "living_time": 1.0
  },
  "zoom_model_fov": 25,
  "sounds": {
    "draw": "tacz:kar98/kar98_draw",
    "put_away": "tacz:kar98/kar98_put_away",
    "shoot": "tacz:kar98/kar98_shoot",
    "shoot_3p": "tacz:kar98/kar98_shoot_3p"
  },
  // 副手枪械显示
  "offhand_show": {
    // 位置，和基岩版的数值显示一致
    // 默认是 [-2, 20, 3.5]
    "pos": [3, 22.5, 3.5],
    // 旋转，单位为角度，默认就是 [0, 0, -30]
    "rotate": [0, 0, 60],
    // 缩放，默认就是 [0.6, 0.6, 0.6]
    "scale": [0.5, 0.5, 0.5]
  },
  // 快捷栏枪械显示
  // 没有此字段，不显示快捷栏枪械
  "hotbar_show": {
    // 快捷栏索引，默认是 0-8，共九个，但是实际上除去主手，只能显示八个
    // 没有的，则不会显示
    "0": {
      "pos": [-3, 22.5, 3],
      "rotate": [-180, 0, 120],
      "scale": [0.5, 0.5, 0.5]
    }
  }
}