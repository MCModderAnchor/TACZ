{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "tacz:muzzle_flash",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "tacz:particle/flash_strip"
      }
    },
    "components": {
      "sbm:fp_emitter_local_space": { "position": true, "rotation": false, "velocity": false, "to_world": false },
      "minecraft:emitter_rate_instant": { "num_particles": 1 },
      "minecraft:emitter_lifetime_once": { "active_time": 0.2 },
      "minecraft:emitter_shape_point": { "offset": [0, 0, 0] },
      "minecraft:particle_lifetime_expression": { "max_lifetime": 0.15 },
      "minecraft:particle_initial_spin": { "rotation": "math.random(-6, 6)", "rotation_rate": 0 },
      "minecraft:particle_appearance_billboard": {
        "size": ["v.muzzle_scale == 0 ? 0.45 : v.muzzle_scale * 0.45", "v.muzzle_scale == 0 ? 0.45 : v.muzzle_scale * 0.45"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 1152,
          "texture_height": 64,
          "flipbook": {
            "base_UV": [256, 0],
            "size_UV": [64, 64],
            "step_UV": [64, 0],
            "frames_per_second": 18,
            "max_frame": 14,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": { "0.0": "#FFFFFFFF", "0.5": "#FFFFFFFF", "1.0": "#00FFFFFF" }
        }
      }
    }
  }
}