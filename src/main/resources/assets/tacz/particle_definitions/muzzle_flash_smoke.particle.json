{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "tacz:muzzle_flash_smoke",
      "basic_render_parameters": {
        "texture": "tacz:particle/smoke_strip"
      }
    },
    "components": {
      "sbm:fp_emitter_local_space": { "position": true, "rotation": false, "velocity": true, "to_world": true },
      "minecraft:emitter_rate_instant": { "num_particles": 15 },
      "minecraft:emitter_lifetime_once": { "active_time": 0.06 },
      "minecraft:emitter_shape_sphere": { "offset": [0, 0, 0.12], "radius": 0.12, "direction": "outwards" },
      "minecraft:particle_lifetime_expression": { "max_lifetime": "math.random(0.08, 0.2)" },
      "minecraft:particle_initial_speed": "v.muzzle_speed == 0 ? 6 : v.muzzle_speed * 6",
      "minecraft:particle_initial_spin": { "rotation": "math.random(-180, 180)", "rotation_rate": "math.random(-60, 60)" },
      "minecraft:particle_motion_dynamic": { "linear_drag_coefficient": 1.5},
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_billboard": {
        "size": ["v.muzzle_scale == 0 ? math.lerp(0.1, 0.32, v.particle_age / v.particle_lifetime) : v.muzzle_scale * math.lerp(0.1, 0.32, v.particle_age / v.particle_lifetime)", "v.muzzle_scale == 0 ? math.lerp(0.1, 0.32, v.particle_age / v.particle_lifetime) : v.muzzle_scale * math.lerp(0.1, 0.32, v.particle_age / v.particle_lifetime)"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 384,
          "texture_height": 64,
          "flipbook": {
            "base_UV": [0, 0],
            "size_UV": [64, 64],
            "step_UV": [64, 0],
            "frames_per_second": 6,
            "max_frame": 6,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": { "0.0": "#99FFFFFF", "0.6": "#55FFFFFF", "1.0": "#00FFFFFF" }
        }
      }
    }
  }
}